# Provedor: fake funciona sem chave e sem rede, groq usa a API real.
LLM_PROVIDER=fake
GROQ_API_KEY=

# Modelo e parâmetros usados na avaliação registrada.
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0
LLM_TOP_P=1.0
LLM_SEED=1
LLM_MAX_TOKENS=2048
LLM_REASONING_EFFORT=low
LLM_INCLUDE_REASONING=false

# Rede: tempo por tentativa, novas tentativas e intervalo entre chamadas de uma comparação.
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
LLM_MIN_INTERVAL_S=20
